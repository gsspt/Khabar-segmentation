{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Clean Boundary Token Extraction - Direct Model Inference\n",
    "\n",
    "Exécute le modèle CAMeL-BERT directement sur kitab_uqala_reference_corpus.txt\n",
    "et extrait les boundary tokens proprement"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 1: Setup & Montage Drive"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from google.colab import drive\n",
    "import time\n",
    "import os\n",
    "\n",
    "drive.mount('/content/drive')\n",
    "time.sleep(2)\n",
    "\n",
    "os.chdir('/content/drive/MyDrive/khabar-segmentation')\n",
    "print(f\"Working directory: {os.getcwd()}\")\n",
    "\n",
    "!pip install transformers torch --quiet\n",
    "print(\"✓ Setup complet\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 2: Charger le Corpus Brut"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "corpus_path = 'data/processed/kitab_uqala_reference_corpus.txt'\n",
    "\n",
    "print(f\"Charger le corpus: {corpus_path}\")\n",
    "with open(corpus_path, 'r', encoding='utf-8') as f:\n",
    "    text = f.read()\n",
    "\n",
    "print(f\"✓ Corpus chargé\")\n",
    "print(f\"  Taille: {len(text):,} caractères\")\n",
    "print(f\"  Début: {text[:100]}...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 3: Charger le Tokenizer et le Modèle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification\n",
    "import torch\n",
    "\n",
    "model_name = \"CAMeL-Lab/bert-base-arabic-camelbert-msa\"\n",
    "\n",
    "print(f\"Charger le tokenizer...\")\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_name)\n",
    "print(f\"✓ Tokenizer: {type(tokenizer).__name__}\")\n",
    "\n",
    "print(f\"\\nCharger le modèle depuis le Drive (ou HuggingFace)...\")\n",
    "# Essayer de charger depuis le Drive d'abord\n",
    "local_model_path = 'checkpoints/camelbert_model'\n",
    "if Path(local_model_path).exists():\n",
    "    print(f\"  Modèle local trouvé: {local_model_path}\")\n",
    "    model = AutoModelForSequenceClassification.from_pretrained(local_model_path)\n",
    "    print(f\"✓ Modèle chargé depuis {local_model_path}\")\nelse:\n",
    "    print(f\"  Modèle local non trouvé, utilisant HuggingFace par défaut\")\n",
    "    # Charger le modèle base (sans fine-tuning)\n",
    "    model = AutoModelForSequenceClassification.from_pretrained(model_name, num_labels=2)\n",
    "    print(f\"✓ Modèle chargé depuis HuggingFace\")\n",
    "\ndevice = 'cuda' if torch.cuda.is_available() else 'cpu'\nmodel = model.to(device)\nmodel.eval()\n\nprint(f\"\\n✓ Modèle prêt (Device: {device})\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 4: Tokeniser le Corpus Complet"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Tokeniser le corpus complet...\")\nprint(f\"  Texte: {len(text):,} caractères\")\n\n# Tokeniser le corpus\ntokens = tokenizer.tokenize(text)\nprint(f\"\\n✓ Tokenisation complète\")\nprint(f\"  Tokens générés: {len(tokens):,}\")\nprint(f\"  Premiers tokens: {tokens[:20]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 5: Encoder les Tokens pour le Modèle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Encoder les tokens avec le tokenizer du modèle...\")\n\n# Encoder le texte complet en utilisant le tokenizer du modèle\nencoded = tokenizer(\n    text,\n    return_tensors='pt',\n    truncation=False,  # Ne pas tronquer\n    max_length=None,  # Pas de limite de longueur\n    padding=False,  # Pas de padding\n    return_offsets_mapping=True  # Pour mapper tokens → caractères\n)\n\nprint(f\"✓ Encodage complète\")\nprint(f\"  Input IDs shape: {encoded['input_ids'].shape}\")\nprint(f\"  Nombre de tokens encodés: {encoded['input_ids'].shape[1]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 6: Inférence du Modèle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Exécuter l'inférence du modèle...\")\nprint(f\"  Nombre de tokens: {encoded['input_ids'].shape[1]}\")\n\nwith torch.no_grad():\n    outputs = model(**{k: v.to(device) for k, v in encoded.items() if k != 'offset_mapping'})\n    logits = outputs.logits\n    predictions = torch.argmax(logits, dim=-1)\n\nprint(f\"\\n✓ Inférence complète\")\nprint(f\"  Logits shape: {logits.shape}\")\nprint(f\"  Prédictions shape: {predictions.shape}\")\n\n# Convertir en numpy\npredictions_np = predictions.cpu().numpy().flatten()\nprint(f\"  Prédictions (numpy): {predictions_np.shape}\")\n\n# Compter les boundary tokens (classe 1)\nboundary_count = (predictions_np == 1).sum()\nprint(f\"\\n  Boundary tokens (classe 1): {boundary_count:,}\")\nprint(f\"  Non-boundary tokens (classe 0): {(predictions_np == 0).sum():,}\")\nprint(f\"  Ratio: {100 * boundary_count / len(predictions_np):.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 7: Mapper les Prédictions aux Tokens"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Mapper les prédictions aux tokens...\")\n\n# Récupérer les tokens et leurs indices\ntoken_ids = encoded['input_ids'][0].cpu().numpy()\noffset_mapping = encoded['offset_mapping'][0].cpu().numpy()\n\nprint(f\"  Token IDs: {len(token_ids)}\")\nprint(f\"  Offset mapping: {len(offset_mapping)}\")\nprint(f\"  Prédictions: {len(predictions_np)}\")\n\n# Créer un mapping: indice → (token, prédiction, position_char)\ntoken_details = []\nfor idx, (token_id, (char_start, char_end), pred) in enumerate(zip(token_ids, offset_mapping, predictions_np)):\n    token_text = tokenizer.decode([token_id])\n    token_details.append({\n        'index': idx,\n        'token': token_text,\n        'token_id': int(token_id),\n        'prediction': int(pred),\n        'char_start': int(char_start),\n        'char_end': int(char_end),\n    })\n\nprint(f\"\\n✓ {len(token_details)} tokens mappés\")\nprint(f\"\\nPremiers tokens:\")\nfor td in token_details[:10]:\n    pred_label = \"BOUNDARY\" if td['prediction'] == 1 else \"non-boundary\"\n    print(f\"  {td['index']:6d}: '{td['token']:15s}' → {pred_label}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 8: Extraire les Boundary Tokens"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Extraire les boundary tokens...\")\n\nboundary_tokens = []\nboundary_indices = []\nboundary_details = []\n\nfor td in token_details:\n    if td['prediction'] == 1:  # Boundary token\n        boundary_tokens.append(td['token'])\n        boundary_indices.append(td['index'])\n        boundary_details.append(td)\n\nprint(f\"\\n✓ Extraction complète\")\nprint(f\"  Total boundary tokens: {len(boundary_tokens):,}\")\nprint(f\"  Pourcentage: {100 * len(boundary_tokens) / len(token_details):.2f}%\")\n\nprint(f\"\\nPremiers 40 boundary tokens:\")\nfor i, token in enumerate(boundary_tokens[:40], 1):\n    print(f\"  {i:3d}. {token}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 9: Créer le Fichier JSON Propre"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from datetime import datetime\n",
    "\n",
    "# Créer les résultats structurés\nresults = {\n    'metadata': {\n",
    "        'corpus': 'kitab_uqala_reference_corpus.txt',\n",
    "        'corpus_size_chars': len(text),\n",
    "        'corpus_size_tokens': len(token_details),\n",
    "        'model': model_name,\n",
    "        'tokenizer': model_name,\n",
    "        'extraction_method': 'Direct model inference on raw corpus',\n",
    "        'device': device,\n",
    "        'timestamp': datetime.now().isoformat(),\n",
    "    },\n",
    "    'statistics': {\n",
    "        'total_tokens': len(token_details),\n",
    "        'boundary_tokens_count': len(boundary_tokens),\n",
    "        'non_boundary_tokens': len(token_details) - len(boundary_tokens),\n",
    "        'boundary_percentage': round(100 * len(boundary_tokens) / len(token_details), 2),\n",
    "        'boundary_ratio': round(len(boundary_tokens) / len(token_details), 4),\n",
    "    },\n",
    "    'boundary_tokens': boundary_tokens,\n",
    "    'boundary_indices': boundary_indices,\n",
    "    'boundary_details': boundary_details[:100],  # Premiers 100 pour référence\n",
    "}\n",
    "\n",
    "# Sauvegarder\noutput_path = 'results/camelbert_boundary_tokens_clean.json'\n",
    "\nwith open(output_path, 'w', encoding='utf-8') as f:\n",
    "    json.dump(results, f, ensure_ascii=False, indent=2)\n",
    "\nfile_size = os.path.getsize(output_path) / 1024\n",
    "\nprint(f\"\\n✓ Sauvegardé: {output_path}\")\nprint(f\"  Taille: {file_size:.1f} KB\")\nprint(f\"\\nRésumé:\")\nprint(f\"  Boundary tokens: {len(boundary_tokens):,}\")\nprint(f\"  Pourcentage: {results['statistics']['boundary_percentage']}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Cell 10: Visualisation"
   ]
  },
  {
   "cell_type": {"code"
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"=\"*80)\n",
    "print(\"RÉSUMÉ FINAL\")\n",
    "print(\"=\"*80)\nprint(f\"\\nCorpus:\")\nprint(f\"  Chemin: {corpus_path}\")\nprint(f\"  Taille: {len(text):,} caractères\")\nprint(f\"\\nTokenisation:\")\nprint(f\"  Tokens totaux: {len(token_details):,}\")\nprint(f\"  Tokenizer: {model_name}\")\nprint(f\"\\nInférence Modèle:\")\nprint(f\"  Modèle: {model_name}\")\nprint(f\"  Device: {device}\")\nprint(f\"\\nBoundary Tokens Extraits:\")\nprint(f\"  Count: {len(boundary_tokens):,}\")\nprint(f\"  Percentage: {results['statistics']['boundary_percentage']}%\")\nprint(f\"\\nFichier Généré:\")\nprint(f\"  {output_path}\")\nprint(f\"  Taille: {file_size:.1f} KB\")\nprint(f\"\\n✓ COMPLET! Prêt pour analyse et visualisation\")"
   ]
  }
 ],
