      "char_start": 13690,
      "char_end": 14197,
      "has_isnad": false,
      "isnad_text": null,
      "text_length": 507
    },
    {
      "unit_id": 58,
      "type": "khabar",
      "char_start": 15156,
      "char_end": 15183,
      "has_isnad": false,
      "isnad_text": null,
      "text_length": 27
    },
    {
      "unit_id": 59,
      "type": "khabar",
      "char_start": 15188,
      "char_end": 15281,
      "has_isnad": false,
      "isnad_text": null,
      "text_length": 93
    },
    {
      "unit_id": 60,
      "type": "khabar",
      "char_start": 15281,
      "char_end": 15304,
      "has_isnad": true,
      "isnad_text": "حدثني أحمد بن حبيب، قال",
      "text_length": 23
    },
    {
      "unit_id": 61,
      "type": "khabar",
      "char_start": 15306,
      "char_end": 15386,
      "has_isnad": true,
      "isnad_text": "وحدثني.. ..\n# .. .. هذا لغورك المجنون: يا أبا محمد، متى [حدث بك هذا العشق؟\n# قال",
      "text_length": 80
    },
    {
      "unit_id": 62,
      "type": "khabar",
      "char_start": 15449,
      "char_end": 15590,
      "has_isnad": true,
      "isnad_text": "أنشدني:\n# كتمت جنوني وهو بالجسم وحده ... [فلما استوى والحب أعلنه الحب]\n# وأخلاه والجسم الصحيح يذيبه ... فلما أذاب [الجسم ذل له القلب]\n# وقال",
      "text_length": 141
    }
  ]
}