      "char_start": 13444,
      "char_end": 13472,
      "has_isnad": true,
      "isnad_text": "روان، نا ابن أبي الدنيا، قال",
      "text_length": 28
    },
    {
      "unit_id": 54,
      "type": "khabar",
      "char_start": 13474,
      "char_end": 13494,
      "has_isnad": false,
      "isnad_text": null,
      "text_length": 20
    },
