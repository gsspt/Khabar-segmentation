  "segments": [
    {
      "id": 0,
      "start": 27,
      "end": 209,
      "isnad_text": "أخبرنا أبو محمد الحسن بن إسماعيل الضراب، نا محمد بن أحمد المديني، نا الحسين بن عبد الله بن يزيد القط",
      "isnad_len": 182,
      "khabar_len": 916
    },
    {
      "id": 1,
      "start": 1125,
      "end": 1262,
      "isnad_text": "يقول:\n# فهام بحب الله في القفر سائحا ... وحطت على روح القدوم رواحله\n# فعاد بشوق قد نضا فقد حاله ... ",
      "isnad_len": 137,
      "khabar_len": 0
    },
    {
      "id": 2,
      "start": 1262,
      "end": 1315,
      "isnad_text": "روان، نا الحسن بن الحسين الكوفي، نا أحمد بن يونس، قال",
      "isnad_len": 53,
      "khabar_len": 94
    },
    {
      "id": 3,
      "start": 1415,
      "end": 1593,
      "isnad_text": "يقول: من أراد سرور الدنيا وحزن الآخرة، فليتمن ما هذا فيه.\n# فوالله لتمنيت أني كنت مت قبل أن ألي القض",
      "isnad_len": 178,
      "khabar_len": 65
    },
    {
      "id": 4,
      "start": 1658,
      "end": 1681,
      "isnad_text": "أخبرني خلف بن سالم، قال",
      "isnad_len": 23,
      "khabar_len": 334
    },
    {
      "id": 5,
      "start": 2015,
      "end": 2068,
      "isnad_text": "روان، نا الحسن بن الحسين الكوفي، نا أحمد بن يونس، قال",
      "isnad_len": 53,
      "khabar_len": 576
    },
    {
      "id": 6,
      "start": 2644,
      "end": 2673,
      "isnad_text": "روان، نا الحسن بن الحسين، قال",
      "isnad_len": 29,
      "khabar_len": 2
    },
    {
      "id": 7,
      "start": 2675,
      "end": 2684,
      "isnad_text": "سمعت أبي",
      "isnad_len": 9,
      "khabar_len": 0
    },
    {
      "id": 8,
      "start": 2684,
      "end": 2747,
      "isnad_text": "يقول:\n# مر بهلول في السوق وهو يأكل، فاستقبله بعض أصحابنا، فقال",
      "isnad_len": 63,
      "khabar_len": 215
    },
    {
      "id": 9,
      "start": 2962,
      "end": 2983,
      "isnad_text": "حدثني عباس البحراني،",
      "isnad_len": 21,
      "khabar_len": 0
    },
    {
      "id": 10,
      "start": 2983,
      "end": 3008,
      "isnad_text": "حدثني سفيان بن عيينة، قال",
      "isnad_len": 25,
      "khabar_len": 175
    },
    {
      "id": 11,
      "start": 3183,
      "end": 3218,
      "isnad_text": "حدثني عبد الكبير بن عبد الرحمن، قال",
      "isnad_len": 35,
      "khabar_len": 2
    },
    {
      "id": 12,
      "start": 3220,
      "end": 3233,
      "isnad_text": "سمعت السكسكي",
      "isnad_len": 13,
      "khabar_len": 0
    },
    {
      "id": 13,
      "start": 3233,
      "end": 3241,
      "isnad_text": "يقول:\n#",
      "isnad_len": 8,
      "khabar_len": 0
    },
    {
      "id": 14,
      "start": 3241,
      "end": 3259,
      "isnad_text": "سمعت وبيص الموسوس",
      "isnad_len": 18,
      "khabar_len": 0
    },
    {
      "id": 15,
      "start": 3259,
      "end": 3295,
      "isnad_text": "يقول، وسأله رجل عن حاله، فأجابه وهو",
      "isnad_len": 36,
      "khabar_len": 0
    },
    {
      "id": 16,
      "start": 3295,
      "end": 3519,
      "isnad_text": "يقول:\n# أجن وما أدري على أي حالة ... ظللت أبالحسنى أم الشر شامل\n# ويقعدني الوسواس حتى كأنني ... صفدت",
      "isnad_len": 224,
      "khabar_len": 0
    },
    {
      "id": 17,
      "start": 3519,
      "end": 3554,
      "isnad_text": "حدثني عبد الكبير بن عبد الرحمن، قال",
      "isnad_len": 35,
      "khabar_len": 2
    },
    {
      "id": 18,
      "start": 3556,
      "end": 3569,
      "isnad_text": "سمعت السكسكي",
      "isnad_len": 13,
      "khabar_len": 0
    },
    {
      "id": 19,
      "start": 3569,
      "end": 3656,
      "isnad_text": "يقول:\n# تماجن قوم على حمان الموسوس يوما، وقد مر بهم، فقدموه ليصلي بهم، فهرب منهم، وأشأ",
      "isnad_len": 87,
      "khabar_len": 0
    },
    {
      "id": 20,
      "start": 3656,
      "end": 3809,
      "isnad_text": "يقول:\n# إن تقديمكم إياي ... من إعواز الأئمه\n# إن ديني لنحيف ... فيه شيء من مرمه\n# نا العصامي، نا أحم",
      "isnad_len": 153,
      "khabar_len": 318
    },
    {
      "id": 21,
      "start": 4127,
      "end": 4415,
      "isnad_text": "أنشدني:\n# أتوني بالطبيب يعالجوني ... على أن قيل: مجنون غريب\n# طلبنا الأجر فيه عساه يوما ... من الأيا",
      "isnad_len": 288,
      "khabar_len": 0
    },
    {
      "id": 22,
      "start": 4415,
      "end": 4435,
      "isnad_text": "حدثني أحمد بن حبيب،",
      "isnad_len": 20,
      "khabar_len": 0
    },
    {
      "id": 23,
      "start": 4435,
      "end": 4445,
      "isnad_text": "حدثني بعض",
      "isnad_len": 10,
      "khabar_len": 0
    },
    {
      "id": 24,
      "start": 4445,
      "end": 4460,
      "isnad_text": "رواة العلم، قال",
      "isnad_len": 15,
      "khabar_len": 109
    },
    {
      "id": 25,
      "start": 4569,
      "end": 4643,
      "isnad_text": "يقول لهم: يا إخوتاه، ما أحر الفراق!.\n# قلت: يا أبا محمد، من أين أقبلت؟ قال",
      "isnad_len": 74,
      "khabar_len": 92
    },
    {
      "id": 26,
      "start": 4735,
      "end": 4847,
      "isnad_text": "يقول:\n# هم رحلوا يوم الخميس غدية ... فودعتهم لما استقلوا وودعوا\n# فلما تولوا ولت النفس معهم ... فقلت",
      "isnad_len": 112,
      "khabar_len": 151
    },
    {
      "id": 27,
      "start": 4998,
      "end": 5038,
      "isnad_text": "روان، نا محمد بن عبد العزيز، نا أبي، قال",
      "isnad_len": 40,
      "khabar_len": 385
    },
    {
      "id": 28,
      "start": 5423,
      "end": 5482,
      "isnad_text": "روان الخزاعي، نا عمر بن محمد التغلبي، نا مرذويه الصائغ، قال",
      "isnad_len": 59,
      "khabar_len": 843
    },
    {
      "id": 29,
      "start": 6325,
      "end": 6386,
      "isnad_text": "حدثني عبد الواحد بن بكر الورثاني، أن منصور بن أحمد الهروي قال",
      "isnad_len": 61,
      "khabar_len": 2
    },
    {
      "id": 30,
      "start": 6388,
      "end": 6430,
      "isnad_text": "سمعت أبا الحسين محمد بن علي الخوارزمي، قال",
      "isnad_len": 42,
      "khabar_len": 2
    },
    {
      "id": 31,
      "start": 6432,
      "end": 6453,
      "isnad_text": "سمعت ذا النون المصري",
      "isnad_len": 21,
      "khabar_len": 0
    },
    {
      "id": 32,
      "start": 6453,
      "end": 6540,
      "isnad_text": "يقول:\n# مررت بأرض مصر، فرأيت الصبيان يرمون رجلا بالحجارة، فقلت لهم: ما تريدون منه؟ فقال",
      "isnad_len": 87,
      "khabar_len": 144
    },
    {
      "id": 33,
      "start": 6684,
      "end": 6700,
      "isnad_text": "يقول هؤلاء؟ فقال",
      "isnad_len": 16,
      "khabar_len": 6
    },
    {
      "id": 34,
      "start": 6706,
      "end": 6746,
      "isnad_text": "يقولون؟ قلت: يزعمون أنك ترى الله.\n# قال",
      "isnad_len": 40,
      "khabar_len": 113
    },
    {
      "id": 35,
      "start": 6859,
      "end": 6943,
      "isnad_text": "يقول:\n# همم المحب تجول في الملكوت بالقلب ... ليسمو، واللسان صموت\n# وزادني غيره: وهو",
      "isnad_len": 84,
      "khabar_len": 0
    },
    {
      "id": 36,
      "start": 6943,
      "end": 7139,
      "isnad_text": "يقول:\n# أيها الشامخ الذي لا يرام ... نحن من طينة عليك السلام\n# إنما هذه الحياة متاع ... ومع الموت تس",
      "isnad_len": 196,
      "khabar_len": 401
    },
    {
      "id": 37,
      "start": 7540,
      "end": 7657,
      "isnad_text": "يقول:\n# أطلب ربا مهيمنا محمود ... بارئ الخلق، ماجد معبود\n# جاد بالفضل والنوال جميعا ... فهو بالفضل و",
      "isnad_len": 117,
      "khabar_len": 106
    },
    {
      "id": 38,
      "start": 7763,
      "end": 7792,
      "isnad_text": "حدثني أبو علي حاجب خاقان، قال",
      "isnad_len": 29,
      "khabar_len": 157
    },
    {
      "id": 39,
      "start": 7949,
      "end": 8099,
      "isnad_text": "يقول:\n# كم يلبث الجنب على الجمر ... لا سيما بعد فناء الصبر\n# سألته الإنصاف في حبه ... فأوكل الأمر إل",
      "isnad_len": 150,
      "khabar_len": 23
    },
    {
      "id": 40,
      "start": 8122,
      "end": 8218,
      "isnad_text": "روان المالكي، نا محمد بن عبد الرحمن مولى بني هاشم، نا مصعب بن عبد الله، عن ابن أبي فديك، أنه قال",
      "isnad_len": 96,
      "khabar_len": 1707
    },
    {
      "id": 41,
      "start": 9925,
      "end": 9962,
      "isnad_text": "روان المالكي، نا إبراهيم بن حبيب، قال",
      "isnad_len": 37,
      "khabar_len": 2
    },
    {
      "id": 42,
      "start": 9964,
      "end": 9978,
      "isnad_text": "سمعت أبا نعيم",
      "isnad_len": 14,
      "khabar_len": 0
    },
    {
      "id": 43,
      "start": 9978,
      "end": 10115,
      "isnad_text": "يقول:\n# مر أبو الديك -وكان معتوها- على معلم كتاب في جبانة كندة، وهو ينشد:\n# إن الصنيعة لا تكون صنيعة",
      "isnad_len": 137,
      "khabar_len": 1122
    },
    {
      "id": 44,
      "start": 11237,
      "end": 11300,
      "isnad_text": "حدثني سليمان بن أحمد بدمشق، نا الحسن بن علي بن جعفر النخعي، قال",
      "isnad_len": 63,
      "khabar_len": 71
    },
    {
      "id": 45,
      "start": 11371,
      "end": 11500,
      "isnad_text": "يقول:\n# من عند من علق الفؤاد بحبه ... فشكا إليه بخاطر مشتاق\n# يبغي إليه من الوصال تقربا ... فيه الشف",
      "isnad_len": 129,
      "khabar_len": 0
    },
    {
      "id": 46,
      "start": 11500,
      "end": 11528,
      "isnad_text": "روان، نا ابن أبي الدنيا، قال",
      "isnad_len": 28,
      "khabar_len": 271
    },
    {
      "id": 47,
      "start": 11799,
      "end": 11953,
      "isnad_text": "يقول:\n# وكافر بالله أمواله ... تزداد أضعافا على كفره\n# ومؤمن ليس له درهم ... يزداد إيمانا على فقره\n#",
      "isnad_len": 154,
      "khabar_len": 280
    },
    {
      "id": 48,
      "start": 12233,
      "end": 12524,
      "isnad_text": "يقول:\n# كم يلبث الجنب على الجمر ... وكم عسى يستعمل الصبر\n# سألته الإنصاف في حبه ... فأوكل الأمر إلى ",
      "isnad_len": 291,
      "khabar_len": 0
    },
    {
      "id": 49,
      "start": 12524,
      "end": 12556,
      "isnad_text": "حدثني قبيصة أبو حاتم المنجم، قال",
      "isnad_len": 32,
      "khabar_len": 69
    },
    {
      "id": 50,
      "start": 12625,
      "end": 12658,
      "isnad_text": "يقول الشعر فسألتهم: بم يعرف؟ فقال",
      "isnad_len": 33,
      "khabar_len": 117
    },
    {
      "id": 51,
      "start": 12775,
      "end": 12811,
      "isnad_text": "يقول: هذه قصورهم، وهذه قبورهم.\n# قال",
      "isnad_len": 36,
      "khabar_len": 361
    },
    {
      "id": 52,
      "start": 13172,
      "end": 13381,
      "isnad_text": "يقول:\n# وما همي لهذا اليوم إني ... لهذا اليوم مضطلع خبير\n# ولكن بعده يوم فظيع ... يروع من مخافته الك",
      "isnad_len": 209,
      "khabar_len": 63
    },
    {
      "id": 53,
      "start": 13444,
      "end": 13472,
      "isnad_text": "روان، نا ابن أبي الدنيا، قال",
      "isnad_len": 28,
      "khabar_len": 2
    },
    {
      "id": 54,
      "start": 13474,
      "end": 13494,
      "isnad_text": "سمعت محمد بن الحسين",
      "isnad_len": 20,
      "khabar_len": 0
    },
    {
      "id": 55,
      "start": 13494,
      "end": 13551,
      "isnad_text": "يقول:\n# قدمت قدمة مكة، فبينا أنا أطوف في السحر، إذ الناس",
      "isnad_len": 57,
      "khabar_len": 0
    },
    {
      "id": 56,
      "start": 13551,
      "end": 13690,
      "isnad_text": "يقولون: قد جاء، قد جاء العنبري الزاهد، فإذا أعرابي جلف المنظر، دخل الطواف، فطاف سبعة أشواط، وركع خلف",
      "isnad_len": 139,
      "khabar_len": 0
    },
    {
      "id": 57,
      "start": 13690,
      "end": 14197,
      "isnad_text": "يقول: سبحان راحم رنة المساكين، وقابل التوبة، والمتفضل بها على المسرفين، الذين أفاض عليهم من سيوب تفض",
      "isnad_len": 507,
      "khabar_len": 959
    },
    {
      "id": 58,
      "start": 15156,
      "end": 15183,
      "isnad_text": "سمعت حمدونة.. .. الفضل بن م",
      "isnad_len": 27,
      "khabar_len": 0
    },
    {
      "id": 59,
      "start": 15188,
      "end": 15281,
      "isnad_text": "يقول لمعلمه ابن الزيات:\n# مهلا حا.. .. قد انصرف عني محاربكم، قد كنت أرج.. .. ربه أحبك.. ..\n#",
      "isnad_len": 93,
      "khabar_len": 0
    },
    {
      "id": 60,
      "start": 15281,
      "end": 15304,
      "isnad_text": "حدثني أحمد بن حبيب، قال",
      "isnad_len": 23,
      "khabar_len": 2
    },
    {
      "id": 61,
      "start": 15306,
      "end": 15386,
      "isnad_text": "وحدثني.. ..\n# .. .. هذا لغورك المجنون: يا أبا محمد، متى [حدث بك هذا العشق؟\n# قال",
      "isnad_len": 80,
      "khabar_len": 63
    },
    {
      "id": 62,
