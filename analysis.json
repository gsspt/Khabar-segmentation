      "segments": [
        {
          "index": 0,
          "type": "prose",
          "text_preview": "بسم الله الرحمن الرحيم"
        },
        {
          "index": 1,
          "type": "prose",
          "text_preview": "وما توفيقي إلا بالله"
        },
        {
          "index": 2,
          "type": "prose",
          "text_preview": "الحمد لله الذي لا يخيب لديه أمل الآملين، ولا يضيع عنده عمل العاملين، فهو جبار ال"
        },
        {
          "index": 3,
          "type": "prose",
          "text_preview": "أما بعد، فإن الله تعالى خلق الدنيا دار زوال، ومحل قلق وانتقال، وجعل أهلها فيها غ"
        }
      ]
    },
    {
      "num": 2,
      "subtype": null,
      "segment_count": 3,
      "segments": [
        {
          "index": 0,
          "type": "isnad",
          "text_preview": "أخبرنا أبو بكر محمد بن عبدالله الأرديشائي في المسجد الحرام قراءة عليه قال : حدثن"
        },
        {
          "index": 1,
          "type": "matn",
          "text_preview": "سئل أبو بكر عن قوله تعالى : والشفع والوتر فقال : الشفع تضاد أوصاف المخلوقين، وال"
        },
        {
          "index": 2,
          "type": "prose",
          "text_preview": "وعلى هذا المثال قرن حبرتهم بالعبرة وفرحهم بالترح. وكذلك قالت الحكماء : كفاك بصحت"
        }
      ]
    },
    {
      "num": 3,
      "subtype": null,
      "segment_count": 2,
      "segments": [
        {
          "index": 0,
          "type": "isnad",
          "text_preview": "أخبرنا محمد بن أحمد قال : حدثنا الحسن بن محمد بن حبيب قال حدثنا أبو عبدالله محمد"
        },
        {
          "index": 1,
          "type": "matn",
          "text_preview": "قال رسول الله صلى الله عليه وسلم: «كفى بالسلامة داء».\n"
        }
      ]
    }
  ],
